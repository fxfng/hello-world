                <mxCell id="jrt1ZYtOC42RSJ1PDuDm-16" value="&lt;b&gt;&lt;font style=&quot;color: rgb(255, 0, 0);&quot;&gt;最终落地的目标&lt;/font&gt;&lt;/b&gt;&lt;div&gt;排除场景1、场景2等情况下减低类别A、类别B等的物料新增&lt;/div&gt;" style="whiteSpace=wrap;html=1;rounded=0;" vertex="1" parent="1">
                    <mxGeometry x="210" y="350" width="120" height="60" as="geometry"/>
